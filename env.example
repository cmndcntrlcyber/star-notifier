# GitHub Stars to Discord Notifier - Configuration Reference
# 
# These values are NOT read from a .env file.
# They must be configured in your GitHub repository settings:
#
# Settings → Secrets and variables → Actions
# ──────────────────────────────────────────────────────────

# ┌─────────────────────────────────────────────────────────┐
# │  SECRETS (Settings → Secrets → New repository secret)  │
# └─────────────────────────────────────────────────────────┘

# Your Discord webhook URL
# Get this from: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYYYYYYYYYY

# ┌─────────────────────────────────────────────────────────┐
# │  VARIABLES (Settings → Variables → New repository var) │
# └─────────────────────────────────────────────────────────┘

# Your GitHub username (public, so use a Variable not a Secret)
GITHUB_USERNAME=your-github-username
